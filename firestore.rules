rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithPhone() {
      return request.auth != null
        && request.auth.token.phone_number is string;
    }

    function isApprovedCoach() {
      return signedInWithPhone()
        && exists(
          /databases/$(database)/documents/approvedCoaches/$(request.auth.token.phone_number)
        )
        && get(
          /databases/$(database)/documents/approvedCoaches/$(request.auth.token.phone_number)
        ).data.active == true;
    }

    match /approvedCoaches/{phoneNumber} {
      allow get: if signedInWithPhone()
        && request.auth.token.phone_number == phoneNumber;
      allow list, create, update, delete: if false;
    }

    match /depthCharts/{document=**} {
      allow read, write: if isApprovedCoach();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
